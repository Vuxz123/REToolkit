import java.util.*;
public class NativeTailCacheFixture {
 /* TYPES */
 static class TaskMonitor extends Monitor {}
 static class CancelledException extends Exception {}
 static class JsonValue {Object value;JsonValue(Object v){value=v;}long getAsLong(){return ((Number)value).longValue();}String getAsString(){return value.toString();}}
 static class JsonObject {
  final Map<String,Object> values=new HashMap<>();boolean has(String key){return values.containsKey(key);}
  JsonObject getAsJsonObject(String key){return (JsonObject)values.get(key);}JsonValue get(String key){return new JsonValue(values.get(key));}
  void addProperty(String key,Object value){values.put(key,value);}
 }
 /* SOURCE_HELPER */
 /* SOURCE_VALIDATOR */
 JsonObject cached(Function f)throws Exception {
  JsonObject cache=new JsonObject(),stored=new JsonObject(),out=new JsonObject();String key="caller",state="unchanged-caller-digest",kind="function";long revision=4;TaskMonitor parent=new TaskMonitor();
  stored.addProperty("revision",revision);stored.addProperty("state",state);cache.values.put(key,stored);
  /* SOURCE_CACHE */return out;
 }
 public static void main(String[] args)throws Exception {
  var f=new NativeTailCacheFixture();Address external=new Address(0x1100);var body=new AddressSetView(0x1000,0x1001,0x1002,0x1003);var caller=new Function(new Address(0x1000),body);
  f.program.listing.instruction=new Instruction("b",new FlowType(false,false,false,true),null,new Address[]{external});
  f.program.manager.entries.put(external,new Function(external,new AddressSetView(0x1100,0x1101,0x1102,0x1103)));
  if(!f.cached(caller).has("noop"))throw new AssertionError("Qualified cached caller must still reuse coverage");
  switch(args[0]){
   case "cached-missing" -> f.program.manager.entries.clear();
   case "cached-replaced-entry" -> f.program.manager.entries.put(external,new Function(new Address(0x1101),new AddressSetView(0x1100,0x1101)));
   case "cached-interior" -> {f.program.manager.entries.clear();f.program.manager.entries.put(new Address(0x10fc),new Function(new Address(0x10fc),new AddressSetView(0x10fc,0x1100,0x1101)));}
   case "cached-overlap" -> f.program.manager.entries.put(external,new Function(external,new AddressSetView(0x1100,0x1000)));
  }
  boolean accepted=args[0].equals("cached-qualified");
  try{var result=f.cached(caller);if(!accepted&&result.has("noop"))throw new AssertionError(args[0]+" must freshly reject invalid dependency or force real reanalysis");}
  catch(IllegalArgumentException e){if(accepted)throw new AssertionError(e);}
 }
}
